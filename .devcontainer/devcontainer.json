{
  "name": "resonant — Rust DSP (embedded + QEMU)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Mount the workspace into /workspace
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",

  // Persist cargo registry and build artefacts across rebuilds
  "mounts": [
    "source=resonant-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=resonant-cargo-git,target=/usr/local/cargo/git,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "serayuzgur.crates"
      ],
      "settings": {
        "rust-analyzer.cargo.features": "all",
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },

  // Port forward if you add a local HTTP server for benchmark reports, etc.
  "forwardPorts": [],

  "remoteUser": "root",

  // Quick-access tasks via the VS Code terminal
  "postCreateCommand": "echo '✓ Container ready. Run: cd ci/no-std-check && cargo build --target thumbv7em-none-eabihf --release'"
}
